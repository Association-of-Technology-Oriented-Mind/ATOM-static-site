# Firebase (project: atom-dscs)
# Console → Project settings → Your apps → SDK setup and configuration
# NOTE: VITE_* values are embedded in the client bundle and are NOT secret.
# Access control comes from Firestore/Storage security rules, not from hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=atom-dscs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=atom-dscs
VITE_FIREBASE_STORAGE_BUCKET=atom-dscs.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (contact form) — https://www.emailjs.com/
# Contact form disables itself gracefully if these are unset.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
