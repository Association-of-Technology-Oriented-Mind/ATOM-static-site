# =============================================================================
# ATOM Club — environment template. Copy to .env and fill in.
#
# Values: Firebase Console → Project settings → Your apps → SDK setup.
#
# IMPORTANT: VITE_* values are compiled into the public JavaScript bundle.
# They are identifiers, not secrets — anyone can read them from the deployed
# site, and that is expected. Access control comes entirely from
# firestore.rules. The only real secret here is .secrets/serviceAccount.json,
# which grants full admin access and bypasses all rules.
# =============================================================================

# --- Firebase (Console → Project settings → Your apps → SDK setup) -----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Storage requires the Blaze (paid) plan and is optional. Left empty, the CMS
# gallery upload tab disables itself and explains the alternative: add photos
# to src/assets/PHOTOS/, commit, redeploy.
# If a bucket is ever created, set this to atom-2026.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=

# --- EmailJS (contact form) — https://www.emailjs.com/ ----------------------
# Unset: the contact form reports itself unavailable and points users at
# atom@karunya.edu instead of silently failing.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
