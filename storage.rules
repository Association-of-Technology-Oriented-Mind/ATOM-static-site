rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Gallery and event images are public to read; only admins may upload.
    // Size and content-type are enforced here because the client check in
    // ImageUpload.tsx is a UX nicety, not a security boundary.
    match /gallery/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
